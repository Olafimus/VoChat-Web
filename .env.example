# Kopieren nach .env und anpassen: cp .env.example .env

# Passwort der Postgres-Datenbank (in Produktion unbedingt aendern)
POSTGRES_PASSWORD=vochat

# Oeffentliche Origin der Web-App (wird als CORS_ORIGINS an das Backend gegeben)
PUBLIC_ORIGIN=http://localhost:8080

# Host-Port, unter dem die Web-App erreichbar ist
WEB_PORT=8080

# Medien-Speicher: none | local | s3
MEDIA_DRIVER=local

# Geheimnis für signierte Links (leer lassen: wird einmalig erzeugt und in der DB gespeichert)
APP_SECRET=

# Admins/Experten: den ersten Admin nach der Registrierung per Kommando vergeben (README, Abschnitt Docker),
# weitere Rollen danach bequem in der App unter /admin.

# ---- E-Mail (Passwort vergessen, Willkommen, Rollen-Hinweise) -----------------
# none (aus) | console (nur Log) | smtp (eigener Server) | gmail
MAIL_DRIVER=none
# Absender; bei Gmail muss es die Adresse des Kontos (oder ein bestätigter Alias) sein
MAIL_FROM=VoChat <noreply@example.com>
# MAIL_REPLY_TO=support@example.com

# Eigener SMTP-Server (MAIL_DRIVER=smtp). Port 465 = TLS, 587 = STARTTLS
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_ALLOW_SELF_SIGNED=

# Gmail (MAIL_DRIVER=gmail): entweder App-Passwort (2-Faktor-Anmeldung noetig) …
# GMAIL_USER=deinname@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# … oder OAuth2 (Google Cloud Console, Scope https://mail.google.com/)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# S3-Medien (nur mit MEDIA_DRIVER=s3; benoetigt @aws-sdk/client-s3 im Backend-Image)
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
